# Optional companion API configuration
DATABASE_URL=sqlite:///./cineplay.db
MONGODB_URI=
MONGODB_DATABASE=cineplay
CORS_ORIGINS=https://mahitech580.github.io,http://localhost:5500

# Live catalog import (leave blank until you configure your own TMDB Read Access Token).
# Never commit a real token; use repository Actions secrets for automated sync.
TMDB_BEARER_TOKEN=
TMDB_SYNC_PAGES=3
TMDB_MAX_MOVIES=1200


# Optional grounded LLM movie Q&A (leave blank for retrieval-only answers).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional semantic embeddings / persistent vector store. Default is lightweight TF-IDF.
CINEPLAY_EMBEDDING_PROVIDER=tfidf
CINEPLAY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CINEPLAY_VECTOR_BACKEND=memory
CINEPLAY_CHROMA_PATH=.cache/chroma

# Optional experiment tracking
CINEPLAY_LOG_MLFLOW=false
MLFLOW_TRACKING_URI=file:./.cache/mlruns
